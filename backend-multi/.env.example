# Placeholders only. Supply credentials through local ignored env files or deployment secrets.
MONGO_URI=
FIREBASE_SERVICE_ACCOUNT_JSON=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
CLIENT_URL=
CORS_ALLOWED_ORIGINS=
# Optional policy overrides; defaults preserve the existing mobile checkout policy.
CHECKOUT_TAX_RATE=
CHECKOUT_SHIPPING_FEE=
CHECKOUT_FREE_SHIPPING_ABOVE=
# Only needed when deliberately running password reset/bootstrap scripts.
RESET_PASSWORD_EMAIL=
RESET_PASSWORD_NEW_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Render web service: npm start from backend-multi; health check /readyz.
NODE_ENV=production
# Render supplies PORT; leave blank locally to use 3001.
PORT=
# Public Next frontend origin for optional hosted Stripe Checkout returns.
FRONTEND_URL=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_ONBOARD_REFRESH_URL=
STRIPE_ONBOARD_RETURN_URL=
# Disable background payouts in the HTTP API unless deliberately enabled.
API_WORKERS_ENABLED=false

# Reservation lifetime; transaction-capable MongoDB required. Expiration runner is operationally scheduled separately.
CHECKOUT_RESERVATION_MINUTES=15
